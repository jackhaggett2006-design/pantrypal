# ---- Supabase (Project Settings -> API) ----
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key (safe to expose to the browser; RLS protects data)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role key (SERVER ONLY — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Anthropic (console.anthropic.com -> API Keys) ----
# Used for food-photo recognition and recipe generation
ANTHROPIC_API_KEY=

# ---- USDA FoodData Central (fdc.nal.usda.gov/api-key-signup) ----
# Free API key for nutrition lookups
USDA_API_KEY=

# ---- App ----
# Base URL of the app (used for auth redirects). Local dev default below.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
